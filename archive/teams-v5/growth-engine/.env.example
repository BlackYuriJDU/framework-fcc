# Copie para .env apenas no ambiente local. Nunca faça commit de valores reais.
SCOUT_MODE=test
LEAD_COUNTRY=Brasil
LEAD_LIMIT=60
SEARCHES_PER_RUN=10
MAX_RETRIES=3

# Obrigatórias apenas em SCOUT_MODE=real ou dry-run
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=8000
GROQ_TEMPERATURE=0.1

TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=20
TAVILY_INCLUDE_RAW=false
TAVILY_DAILY_CREDIT_LIMIT=30

MAX_CHARS_PER_RESULT=900
MAX_RESULTS_PER_BATCH=8
DATA_DIR=data
LOG_DIR=logs
LEADS_FILE=leads-master.json
HISTORY_FILE=lead-history.json
BUDGET_FILE=tavily-budget.json
DUPLICATES_FILE=duplicates.json
REJECTED_FILE=rejected.json

ENABLE_SUPABASE=false
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
