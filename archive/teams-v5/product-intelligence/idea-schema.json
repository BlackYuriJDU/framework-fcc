{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vertexion Product Intelligence Workspace",
  "type": "object",
  "required": ["title", "type", "status", "opportunityScore", "confidence", "evidenceLevel", "verdict"],
  "properties": {
    "title": {"type": "string", "minLength": 3},
    "type": {"enum": ["project", "feature", "offer", "pricing", "integration", "strategy", "technical-change"]},
    "status": {"enum": ["intake", "research", "experiment", "decided", "paused", "archived"]},
    "opportunityScore": {"type": "number", "minimum": 0, "maximum": 100},
    "confidence": {"type": "number", "minimum": 0, "maximum": 100},
    "evidenceLevel": {"type": "integer", "minimum": 0, "maximum": 5},
    "verdict": {"enum": ["PROSSEGUIR", "VALIDAR PRIMEIRO", "REFORMULAR OU PAUSAR", "NÃO RECOMENDADO AGORA"]}
  }
}
